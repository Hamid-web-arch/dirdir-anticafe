# Canlı backend ünvanı (gizli deyil — onsuz da saytın JS faylında görünür).
# Vercel və GitHub Pages build-ləri bunu avtomatik götürür.
VITE_API_URL=https://dirdir-api.onrender.com

# Saytın əsas ünvanı — Google-a göstərilən kanonik ünvan, sitemap.xml və sosial önizləmələr üçün.
# Əsas domen www.dirdir.az-dır (Vercel dirdir.az-ı ora yönləndirir).
VITE_SITE_URL=https://www.dirdir.az
