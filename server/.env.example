# Bu faylı .env adı ilə köçür və dəyərləri doldur. .env git-ə düşmür.

# Lokal: `npm run db:local` bu ünvanı çap edir. Canlı: Neon / Render / Railway PostgreSQL ünvanı.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/dirdir"

# Uzun, təsadüfi sətir. Yaratmaq üçün:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

PORT=4000

# Frontend-in ünvanları (vergüllə). Canlı sayt + lokal dev serverlər.
CORS_ORIGINS="https://hamid-web-arch.github.io,http://localhost:5173,http://localhost:5174"

# İlk admin (`npm run db:seed`)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_PHONE=""
