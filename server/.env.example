# Bu faylı .env adı ilə köçür və dəyərləri doldur. .env git-ə düşmür.

# Lokal: `npm run db:local` bu ünvanı çap edir. Canlı: Neon / Render / Railway PostgreSQL ünvanı.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/dirdir"

# Uzun, təsadüfi sətir. Yaratmaq üçün:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

PORT=4000

# Frontend-in ünvanları (vergüllə). Canlı sayt + lokal dev serverlər.
CORS_ORIGINS="https://dirdir-anticafe.vercel.app,http://localhost:5173,http://localhost:5174"

# İlk admin (`npm run db:seed`)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_PHONE=""

# Email: qeydiyyat kodu, şifrə bərpası, admin paneldən xəbərlər.
# Lokalda boş qala bilər — məktublar göndərilmir, serverin terminalına yazılır (kodu oradan götür).
# Canlı: resend.com → API Keys. Göndərən ünvanın domeni (dirdir.az) Resend-də təsdiqlənməlidir.
RESEND_API_KEY=""
MAIL_FROM="DırDır Anticafe <noreply@dirdir.az>"

# SMTP — yalnız SMTP-yə icazə verən hostinqdə (Render-in pulsuz planı SMTP portlarını bağlayır).
# Gmail: 2 addımlı doğrulama → myaccount.google.com/apppasswords → "App password" → SMTP_PASS.
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
