generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum CompetitionStatus {
  UPCOMING // elan olunub, hələ başlamayıb
  ONGOING // gedir
  FINISHED // bitib
}

model User {
  id                String    @id @default(cuid())
  firstName         String
  lastName          String
  email             String    @unique // həmişə kiçik hərflə saxlanır
  phone             String    @unique // 9 rəqəm, +994-süz (məs. 501234567)
  passwordHash      String
  passwordChangedAt DateTime? // bu andan əvvəl verilmiş tokenlər etibarsızdır (şifrə dəyişəndə)
  role              Role      @default(USER)
  isSuperAdmin      Boolean   @default(false) // baş admin: bütün bölmələr + digər adminləri idarə edir
  permissions       String[]  @default([]) // adi admin: açıq bölmələr (server/src/permissions.js)
  blockedAt         DateTime? // doluysa — admin bloklayıb, daxil ola bilmir
  newsletter        Boolean   @default(false) // yeniliklərdən xəbərdar olmaq istəyir (qeydiyyatda və profildə açar)
  avatarId          String?   @unique
  avatar            Image?    @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  teams         Team[]
  pointsAwarded TeamPointEntry[]
  feedback      Feedback[]
  broadcasts    Broadcast[]
  visits        Visit[]          @relation("UserVisits")
  visitsLogged  Visit[]          @relation("VisitCreatedBy")
}

// Yüklənmiş şəkillər (slider, profil). Serverdə kiçildilib WebP-yə çevrilir.
model Image {
  id        String   @id @default(cuid())
  mime      String
  data      Bytes
  width     Int
  height    Int
  size      Int
  createdAt DateTime @default(now())

  slide Slide?
  game  Game?
  user  User?  @relation("UserAvatar")
}

// "Nələr var?" slayderi. Mətnlər { az, en, ru } obyektidir.
model Slide {
  id        String   @id @default(cuid())
  position  Int
  imageId   String   @unique
  image     Image    @relation(fields: [imageId], references: [id])
  fit       String   @default("cover") // cover | contain (yazılı posterlər üçün)
  title     Json
  desc      Json
  body      Json     @default("{}") // "Ətraflı" səhifəsinin mətni { az, en, ru }; boşdursa səhifə yoxdur
  link      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

model Competition {
  id               String            @id @default(cuid())
  title            Json // { az, en, ru }
  description      Json // { az, en, ru }
  startsAt         DateTime
  status           CompetitionStatus @default(UPCOMING)
  registrationOpen Boolean           @default(true)
  maxTeams         Int?
  prizes           Json              @default("[]") // [{ place: 1, title: { az, en, ru } }], yerə görə sıralı
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  teams Team[]

  @@index([status, startsAt])
}

// Yarışa qoşulma: bir istifadəçi bir yarışa bir komanda adı ilə qoşulur.
model Team {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  nameKey       String // kiçik hərflə — eyni yarışda təkrar ad olmasın
  points        Int         @default(0)
  createdAt     DateTime    @default(now())

  pointEntries TeamPointEntry[]

  @@unique([competitionId, userId])
  @@unique([competitionId, nameKey])
  @@index([competitionId, points])
}

// Komandaya verilən hər xal: kim, nə qədər, niyə.
model TeamPointEntry {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  amount      Int
  reason      String
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([teamId, createdAt])
}

// Kiçik açar-dəyər qeydləri (məs. "standart slaydlar artıq əlavə olunub").
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PromoCode {
  id        String    @id @default(cuid())
  code      String    @unique // həmişə böyük hərflə saxlanır
  percent   Int
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Oyunlar səhifəsi: admin kart kimi əlavə edir; karta basanda oyunun öz səhifəsi açılır.
model Game {
  id        String   @id @default(cuid())
  position  Int
  imageId   String   @unique
  image     Image    @relation(fields: [imageId], references: [id])
  title     Json // { az, en, ru }
  summary   Json // kartdakı qısa təsvir
  howTo     Json // necə oynanılır (oyunun səhifəsində)
  players   String? // məs. "2–6"
  duration  String? // məs. "30–45 dəq"
  age       String? // məs. "8+"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

// Saytdakı "Rəy və təkliflər" forması
model Feedback {
  id        String   @id @default(cuid())
  name      String?
  contact   String? // email və ya telefon (könüllü)
  message   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

// Admin paneldən istifadəçilərə göndərilən xəbərlər (tarixçə)
model Broadcast {
  id             String   @id @default(cuid())
  channel        String // email | whatsapp
  subject        String
  body           String
  recipientCount Int
  sentCount      Int      @default(0)
  failedCount    Int      @default(0)
  createdById    String?
  createdBy      User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
}

// Günün hesabatı: admin anticafeyə gələn hər müştərinin seansını qeyd edir.
// Qeydiyyatlı istifadəçidirsə userId doludur — seans onun kabinetində də görünür.
model Visit {
  id            String    @id @default(cuid())
  day           String // Bakı vaxtı ilə başlama günü, YYYY-MM-DD (tarixçə bu sahə ilə qruplanır)
  userId        String?
  user          User?     @relation("UserVisits", fields: [userId], references: [id], onDelete: SetNull)
  name          String // müştərinin adı (qeydiyyatlı istifadəçidə — o anki adı)
  kind          String    @default("hall") // hall (ümumi zal) | room (kino otağı)
  students      Int       @default(0) // onlardan neçəsi tələbədir (tələbə endirimi, yalnız zalda)
  people        Int       @default(1)
  promoCode     String? // tətbiq olunan promokod
  promoPercent  Int? // kodun o anki faizi (kod sonra dəyişsə/silinsə də seansın endirimi qalır) // neçə nəfər (qrup bir nəfərin adına yazılır; məbləğ nəfər başına × say)
  startedAt     DateTime
  endedAt       DateTime? // boşdursa seans davam edir
  minutes       Int? // bitəndə: qalma müddəti (dəqiqə)
  amount        Decimal?  @db.Decimal(8, 2) // bitəndə: hesablanan məbləğ (o anki qiymətlərlə)
  paymentMethod String? // bitəndə: cash (nağd) | card (kart)
  note          String?
  createdById   String?
  createdBy     User?     @relation("VisitCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([day, startedAt])
  @@index([userId, startedAt])
  @@index([endedAt])
}
